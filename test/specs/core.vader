" ============================================================================
" ghostgit.vim - Core Functions Tests
" ============================================================================

Before:
  " Inicializar estado de GhostGit
  call ghostgit#state#Init()
  
  " Configurar repositorio de prueba
  let g:repo = ghostgit#test#Setup()
  
  " Crear directorio temporal plano para pruebas negativas
  let g:plain = tempname()
  call mkdir(g:plain, 'p')
  
  " Guardar directorio de trabajo actual
  let g:cwd = getcwd()

After:
  " Limpiar repositorio de prueba
  call ghostgit#test#Teardown(g:repo)
  
  " Eliminar directorio temporal
  call delete(g:plain, 'rf')
  
  " Restaurar directorio de trabajo original
  execute 'cd ' . fnameescape(g:cwd)

" ============================================================================
" ghostgit#core#Run Tests
" ============================================================================

Execute (ghostgit#core#Run with list args):
  let g:result = ghostgit#core#Run(['rev-parse', '--show-toplevel'], g:repo)
  Assert g:result[0] ==# g:repo

Execute (ghostgit#core#Run with string arg):
  let g:result = ghostgit#core#Run('status', g:repo)
  Assert len(g:result) > 0

Execute (ghostgit#core#Run returns empty list on failure):
  let g:result = ghostgit#core#Run(['rev-parse', '--show-toplevel'], g:plain)
  AssertEqual [], g:result

Execute (ghostgit#core#Run defaults cwd to getcwd()):
  execute 'cd ' . fnameescape(g:repo)
  let g:result = ghostgit#core#Run(['rev-parse', '--show-toplevel'])
  Assert g:result[0] ==# g:repo

Execute (ghostgit#core#Run handles non-existent directory):
  let g:result = ghostgit#core#Run(['status'], '/non/existent/path')
  AssertEqual [], g:result

Execute (ghostgit#core#Run with complex command):
  " Crear un archivo de prueba
  call writefile(['test content'], g:repo . '/test.txt')
  let g:result = ghostgit#core#Run(['add', 'test.txt'], g:repo)
  AssertEqual [], g:result

Execute (ghostgit#core#Run preserves exit codes):
  " Comando que debe fallar
  let g:result = ghostgit#core#Run(['invalid-command'], g:repo)
  " Debería devolver el output incluso en caso de error

" ============================================================================
" ghostgit#core#RepoRoot Tests
" ============================================================================

Execute (ghostgit#core#RepoRoot returns repo root):
  execute 'cd ' . fnameescape(g:repo)
  let g:root = ghostgit#core#RepoRoot()
  Assert g:root ==# g:repo

Execute (ghostgit#core#RepoRoot returns empty string outside repo):
  execute 'cd ' . fnameescape(g:plain)
  let g:root = ghostgit#core#RepoRoot()
  Assert g:root ==# ''

Execute (ghostgit#core#RepoRoot with explicit cwd):
  let g:root = ghostgit#core#RepoRoot(g:repo)
  Assert g:root ==# g:repo

Execute (ghostgit#core#RepoRoot caching works):
  " Primera llamada
  let g:root1 = ghostgit#core#RepoRoot(g:repo)
  " Segunda llamada debería usar caché
  let g:root2 = ghostgit#core#RepoRoot(g:repo)
  Assert g:root1 ==# g:root2

Execute (ghostgit#core#RepoRoot handles invalid paths):
  let g:root = ghostgit#core#RepoRoot('/invalid/path')
  Assert g:root ==# ''

" ============================================================================
" ghostgit#core#CurrentBranch Tests
" ============================================================================

Execute (ghostgit#core#CurrentBranch returns branch name):
  let g:branch = ghostgit#core#CurrentBranch(g:repo)
  Assert g:branch ==# 'main'

Execute (ghostgit#core#CurrentBranch returns empty string outside repo):
  let g:branch = ghostgit#core#CurrentBranch(g:plain)
  Assert g:branch ==# ''

Execute (ghostgit#core#CurrentBranch with explicit cwd):
  execute 'cd ' . fnameescape(g:repo)
  let g:branch = ghostgit#core#CurrentBranch()
  Assert g:branch ==# 'main'

Execute (ghostgit#core#CurrentBranch handles detached HEAD):
  " Crear un commit adicional y detach HEAD
  execute 'cd ' . fnameescape(g:repo)
  call ghostgit#core#Run(['commit', '--allow-empty', '-m', 'Second commit'])
  call ghostgit#core#Run(['checkout', 'HEAD~1'])
  let g:branch = ghostgit#core#CurrentBranch()
  Assert g:branch =~# 'HEAD detached'

" ============================================================================
" ghostgit#core#IsRepo Tests
" ============================================================================

Execute (ghostgit#core#IsRepo returns 1 inside a repo):
  Assert ghostgit#core#IsRepo(g:repo)

Execute (ghostgit#core#IsRepo returns 0 outside a repo):
  Assert !ghostgit#core#IsRepo(g:plain)

Execute (ghostgit#core#IsRepo with explicit cwd):
  execute 'cd ' . fnameescape(g:repo)
  Assert ghostgit#core#IsRepo()

Execute (ghostgit#core#IsRepo caching works):
  " Primera llamada
  let g:is_repo1 = ghostgit#core#IsRepo(g:repo)
  " Segunda llamada debería usar caché
  let g:is_repo2 = ghostgit#core#IsRepo(g:repo)
  Assert g:is_repo1 ==# g:is_repo2

Execute (ghostgit#core#IsRepo handles invalid paths):
  Assert !ghostgit#core#IsRepo('/invalid/path')

" ============================================================================
" Additional Edge Case Tests
" ============================================================================

Execute (Core functions handle empty inputs gracefully):
  " Probar funciones con entradas vacías
  let g:empty_result = ghostgit#core#Run([])
  AssertEqual [], g:empty_result

Execute (Core functions handle null cwd):
  let g:result = ghostgit#core#Run('status', '')
  " Debería usar getcwd() como fallback

Execute (Core functions validate arguments):
  try
    " Esto debería lanzar una excepción
    let g:result = ghostgit#core#Run('', g:repo)
  catch
    " Verificar que se lanzó la excepción esperada
    Assert 1 == 1
  endtry

" ============================================================================
" Performance Tests
" ============================================================================

Execute (Core functions perform reasonably fast):
  " Medir tiempo de ejecución para RepoRoot
  let l:start = reltime()
  for l:i in range(100)
    let g:dummy = ghostgit#core#RepoRoot(g:repo)
  endfor
  let l:elapsed = reltimefloat(reltime(l:start))
  " Debería tomar menos de 1 segundo para 100 llamadas
  Assert l:elapsed < 1.0

" ============================================================================
" Integration Tests
" ============================================================================

Execute (Core functions work together correctly):
  " Verificar flujo típico de uso
  Assert ghostgit#core#IsRepo(g:repo)
  let g:branch = ghostgit#core#CurrentBranch(g:repo)
  Assert !empty(g:branch)
  let g:root = ghostgit#core#RepoRoot(g:repo)
  Assert !empty(g:root)
  let g:status = ghostgit#core#Run('status', g:repo)
  Assert !empty(g:status)