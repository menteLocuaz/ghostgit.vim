" ============================================================================
" ghostgit - Core API Tests
" ============================================================================

Execute (ghostgit#core#IsRepo returns boolean):
  Assert type(ghostgit#core#IsRepo()) == v:t_number

Execute (ghostgit#core#RepoRoot returns string):
  Assert type(ghostgit#core#RepoRoot()) == v:t_string

Execute (ghostgit#core#CurrentBranch returns string):
  let g:branch = ghostgit#core#CurrentBranch()
  Assert type(g:branch) == v:t_string

Execute (ghostgit#core#Run executes git command):
  let g:output = ghostgit#core#Run(['version'])
  Assert len(g:output) > 0
  Assert g:output[0] =~# '^git version'
