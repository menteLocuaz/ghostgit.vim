" ============================================================================
" Performance and Edge Case Tests
" ============================================================================

Execute (Utility functions perform reasonably fast):
  let l:start = reltime()
  for l:i in range(100)
    call ghostgit#util#OpenBuffer('perf_test_' . l:i)
    call ghostgit#util#Render(['test line 1', 'test line 2'])
    silent! bd!
  endfor
  let l:elapsed = reltimefloat(reltime(l:start))
  Assert l:elapsed < 1.0  " Debería ser rápido incluso con muchas operaciones

Execute (Utility functions handle very long messages):
  call ghostgit#util#OpenBuffer('long_msg_test')
  let l:very_long_message = repeat('Long message content. ', 100)
  call ghostgit#util#Render([l:very_long_message])
  Assert getline(1) ==# l:very_long_message
  silent! bd! ghostgit://long_msg_test

Execute (Utility functions maintain buffer integrity):
  " Abrir buffer
  call ghostgit#util#OpenBuffer('integrity_test')
  
  " Verificar configuración inicial
  Assert &bufhidden ==# 'wipe'
  Assert &buftype ==# 'nofile'
  
  " Realizar varias operaciones de renderizado
  call ghostgit#util#Render(['line1'])
  call ghostgit#util#Render(['line2', 'line3'])
  call ghostgit#util#Render(['final', 'lines', 'here'])
  
  " Verificar que la configuración se mantiene
  Assert &bufhidden ==# 'wipe'
  Assert &buftype ==# 'nofile'
  Assert !&swapfile
  Assert !&modifiable
  
  silent! bd! ghostgit://integrity_test