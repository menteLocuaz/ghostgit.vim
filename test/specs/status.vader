Before:
  call ghostgit#state#Init()
  let g:repo = ghostgit#test#Setup()
  let g:cwd = getcwd()

After:
  call ghostgit#test#Teardown(g:repo)
  execute 'cd ' . fnameescape(g:cwd)
  silent! bd! ghostgit://status

Execute (status#Open opens status buffer in repo):
  execute 'cd ' . fnameescape(g:repo)
  call ghostgit#status#Open()
  Assert bufname('%') =~# 'ghostgit://status'
  Assert len(getline(1, '$')) > 0

Execute (status#Open does not error outside repo):
  let g:plain = tempname()
  call mkdir(g:plain, 'p')
  execute 'cd ' . fnameescape(g:plain)
  let g:caught = 0
  try
    call ghostgit#status#Open()
  catch
    let g:caught = 1
  endtry
  call delete(g:plain, 'rf')
  Assert !g:caught

Execute (stage adds file to index):
  execute 'cd ' . fnameescape(g:repo)
  call ghostgit#status#Open()
  call ghostgit#test#CreateFile(g:repo, 'test.txt', 'content')
  call ghostgit#status#Refresh()
  call ghostgit#git#Add('test.txt', g:repo)
  let g:st = ghostgit#git#Status(g:repo)
  let g:staged = filter(copy(g:st), {_, v -> v =~# 'A '})
  Assert len(g:staged) > 0
