" ============================================================================
" Edge Cases and Error Handling Tests
" ============================================================================

Execute (status functions handle empty repository):
  " Configurar repositorio vacío (sin commits)
  let g:empty_repo = ghostgit#test#SetupEmptyRepo()
  
  " Cambiar al repositorio vacío
  execute 'cd ' . fnameescape(g:empty_repo)
  
  " Abrir status en repositorio vacío
  call ghostgit#status#Open()
  
  " Debería mostrar información apropiada para repositorio vacío
  let g:text = join(getline(1, '$'), "\n")
  " Verificar contenido apropiado
  
  " Limpiar
  call ghostgit#test#Teardown(g:empty_repo)

Execute (status functions handle large repositories):
  " Cambiar al directorio del repositorio
  execute 'cd ' . fnameescape(g:repo)
  
  " Crear muchos archivos
  for i in range(50)
    call ghostgit#test#CreateFile(g:repo, 'file' . i . '.txt', 'content' . i)
  endfor
  
  " Abrir status
  call ghostgit#status#Open()
  
  " Refrescar status
  call ghostgit#status#Refresh()
  
  " Verificar que maneja muchos archivos apropiadamente
  let g:lines = getline(1, '$')
  Assert len(g:lines) > 10

Execute (status functions handle unicode filenames):
  " Cambiar al directorio del repositorio
  execute 'cd ' . fnameescape(g:repo)
  
  " Crear archivo con nombre Unicode
  call ghostgit#test#CreateFile(g:repo, '测试文件.txt', 'unicode content')
  
  " Abrir status
  call ghostgit#status#Open()
  
  " Refrescar status
  call ghostgit#status#Refresh()
  
  " Verificar que muestra archivo Unicode
  let g:text = join(getline(1, '$'), "\n")
  Assert g:text =~# '测试文件.txt'

Execute (status functions handle special characters):
  " Cambiar al directorio del repositorio
  execute 'cd ' . fnameescape(g:repo)
  
  " Crear archivo con caracteres especiales
  call ghostgit#test#CreateFile(g:repo, 'file with spaces & symbols!.txt', 'special content')
  
  " Abrir status
  call ghostgit#status#Open()
  
  " Refrescar status
  call ghostgit#status#Refresh()
  
  " Verificar que muestra archivo con caracteres especiales
  let g:text = join(getline(1, '$'), "\n")
  Assert g:text =~# 'file with spaces & symbols!.txt'

" ============================================================================
" Performance Tests
" ============================================================================

Execute (status operations perform reasonably fast):
  " Cambiar al directorio del repositorio
  execute 'cd ' . fnameescape(g:repo)
  
  " Crear archivos de prueba
  for i in range(100)
    call ghostgit#test#CreateFile(g:repo, 'perf_test_' . i . '.txt', 'performance test content')
  endfor
  
  " Medir tiempo de apertura
  let g:open_start = reltime()
  call ghostgit#status#Open()
  let g:open_time = reltimefloat(reltime(g:open_start))
  
  " Medir tiempo de refresco
  let g:refresh_start = reltime()
  call ghostgit#status#Refresh()
  let g:refresh_time = reltimefloat(reltime(g:refresh_start))
  
  " Verificar tiempos razonables
  Assert g:open_time < 2.0
  Assert g:refresh_time < 1.0

" ============================================================================
" Integration Tests
" ============================================================================

Execute (status buffer integrates with state management):
  " Cambiar al directorio del repositorio
  execute 'cd ' . fnameescape(g:repo)
  
  " Abrir buffer de estado
  call ghostgit#status#Open()
  
  " Verificar que el estado se actualizó apropiadamente
  let g:buffer_info = ghostgit#state#GetBuffer('status')
  Assert !empty(g:buffer_info)
  AssertEqual 'status', g:buffer_info.type
  
  " Verificar que hay items en caché
  let g:cached_items = ghostgit#state#GetCachedItems('status')
  " Assert !empty(g:cached_items)  " Puede estar vacío inicialmente

Execute (status buffer closes properly):
  " Cambiar al directorio del repositorio
  execute 'cd ' . fnameescape(g:repo)
  
  " Abrir buffer de estado
  call ghostgit#status#Open()
  
  " Verificar que existe
  Assert bufname('%') =~# 'ghostgit://status'
  
  " Cerrar buffer
  silent! bd!
  
  " Verificar que ya no existe el buffer activo de status
  Assert bufname('%') !~# 'ghostgit://status'