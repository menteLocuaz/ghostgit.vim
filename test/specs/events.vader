" ============================================================================
" ghostgit.vim - Event Handler Tests
" ============================================================================

Before:
  let g:ghostgit_async_disable = 1
  call ghostgit#state#Init()
  let g:cwd = getcwd()
  let g:repo = ghostgit#test#Setup()

After:
  execute 'cd ' . fnameescape(g:cwd)
  call ghostgit#test#Teardown(g:repo)
  silent! bwipeout! ghostgit://status
  silent! bwipeout! ghostgit://log
  silent! bwipeout! ghostgit://branch
  silent! bwipeout! ghostgit://diff

" ============================================================================
" ghostgit#events#Init Tests
" ============================================================================

Execute (events#Init sets up the expected augroup and custom events):
  augroup GhostGitAutoRefresh
    autocmd!
  augroup END

  let g:ghostgit_autorefresh_events = ['BufWritePost', 'User MyCustomEvent']
  call ghostgit#events#Init()

  let g:_ev_out = execute('autocmd GhostGitAutoRefresh')
  Assert g:_ev_out =~# 'BufWritePost'
  Assert g:_ev_out =~# 'MyCustomEvent'

  unlet g:ghostgit_autorefresh_events

Execute (events#Init respects g:ghostgit_disable_autorefresh):
  let g:ghostgit_disable_autorefresh = 1

  augroup GhostGitAutoRefresh
    autocmd!
  augroup END

  call ghostgit#events#Init()

  try
    let g:_ev_out2 = execute('autocmd GhostGitAutoRefresh')
    Assert g:_ev_out2 !~# 'BufWritePost'
  catch /E216/
  endtry

  unlet g:ghostgit_disable_autorefresh

" ============================================================================
" OnFilesystemChange Logic Tests
" ============================================================================

Execute (Fast Path: Does nothing if current buffer is not in a git repo):
  let g:plain = tempname()
  call mkdir(g:plain, 'p')
  execute 'cd ' . fnameescape(g:plain)
  execute 'edit dummy.txt'
  Assert empty(ghostgit#core#RepoRoot())
  call delete(g:plain, 'rf')

Execute (Visibility Check: refreshes visible buffers):
  execute 'cd ' . fnameescape(g:repo)

  call ghostgit#status#Open()
  let g:status_bufnr = bufnr('%')

  call ghostgit#log#Open()
  let g:log_bufnr = bufnr('%')
  execute 'buffer ' . g:status_bufnr

  Assert bufwinid(g:status_bufnr) != -1

  call ghostgit#test#CreateFile(g:repo, 'visibility_test.txt', 'test content')

  doautocmd BufWritePost dummy.txt

  Assert bufname('%') =~# 'ghostgit://status'

Execute (Multi-Buffer: Opens and refreshes status and log):
  execute 'cd ' . fnameescape(g:repo)

  call ghostgit#status#Open()
  vsplit
  call ghostgit#log#Open()

  Assert bufwinid(bufnr('ghostgit://status')) != -1
  Assert bufwinid(bufnr('ghostgit://log')) != -1

  call ghostgit#test#CreateFile(g:repo, 'multi_test.txt', 'test content')

  doautocmd BufWritePost dummy.txt

  wincmd p
  Assert getline(1) =~# 'GhostGit'
