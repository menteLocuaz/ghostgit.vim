Before:
  let g:ghostgit_async_disable = 1
  let g:repo = ghostgit#test#Setup()
  let g:cwd = getcwd()

After:
  call ghostgit#test#Teardown(g:repo)
  execute 'cd ' . fnameescape(g:cwd)
  silent! bd!

Execute (diff#Open with --cached shows diff):
  execute 'cd ' . fnameescape(g:repo)
  call ghostgit#test#CreateFile(g:repo, 'stage_test.txt', "hello\nworld\n")
  call ghostgit#test#StageFile(g:repo, 'stage_test.txt')
  call ghostgit#diff#Open('stage_test.txt', '--cached')
  let g:text = join(getline(1, '$'), "\n")
  Assert len(getline(1, '$')) > 0
  Assert g:text =~# 'diff --git'
  Assert &filetype ==# 'diff'

Execute (diff#Open without cache shows diff):
  execute 'cd ' . fnameescape(g:repo)
  call ghostgit#test#CreateFile(g:repo, 'nocache_test.txt', "hello\nworld\n")
  call ghostgit#test#StageFile(g:repo, 'nocache_test.txt')
  call ghostgit#test#CreateFile(g:repo, 'nocache_test.txt', "hello\nworld\nnew line\n")
  call ghostgit#diff#Open('nocache_test.txt')
  let g:text = join(getline(1, '$'), "\n")
  Assert len(getline(1, '$')) > 0
  Assert g:text =~# 'diff --git'
  Assert g:text =~# 'new line'

Execute (diff#Open with unstaged file):
  execute 'cd ' . fnameescape(g:repo)
  call ghostgit#test#CreateFile(g:repo, 'unstage_test.txt', "initial content\n")
  call ghostgit#test#StageFile(g:repo, 'unstage_test.txt')
  call ghostgit#core#Run(['commit', '-m', 'add unstage_test'], g:repo)
  call ghostgit#test#CreateFile(g:repo, 'unstage_test.txt', "modified content\n")
  call ghostgit#diff#Open('unstage_test.txt')
  let g:text = join(getline(1, '$'), "\n")
  Assert len(getline(1, '$')) > 0
  Assert g:text =~# 'diff --git'

Execute (diff#Open handles non-existent file):
  execute 'cd ' . fnameescape(g:repo)
  call ghostgit#diff#Open('nonexistent.txt')

Execute (diff#Open with multiple extra args):
  execute 'cd ' . fnameescape(g:repo)
  call ghostgit#test#CreateFile(g:repo, 'extra_test.txt', "original\n")
  call ghostgit#test#StageFile(g:repo, 'extra_test.txt')
  call ghostgit#test#CreateFile(g:repo, 'extra_test.txt', "original\nmodified\n")
  call ghostgit#diff#Open('extra_test.txt', '--word-diff')
  let g:text = join(getline(1, '$'), "\n")
  Assert len(getline(1, '$')) > 0

Execute (diff#Open sets proper buffer options):
  execute 'cd ' . fnameescape(g:repo)
  call ghostgit#test#CreateFile(g:repo, 'bufopts_test.txt', "test\n")
  call ghostgit#test#StageFile(g:repo, 'bufopts_test.txt')
  call ghostgit#core#Run(['commit', '-m', 'add bufopts_test'], g:repo)
  call ghostgit#test#CreateFile(g:repo, 'bufopts_test.txt', "test\nmodified\n")
  call ghostgit#diff#Open('bufopts_test.txt')
  Assert &buftype ==# 'nofile'
  Assert &bufhidden ==# 'wipe'
  Assert !&swapfile
  Assert !&modifiable

Execute (diff#Open reuses existing buffer):
  execute 'cd ' . fnameescape(g:repo)
  call ghostgit#test#CreateFile(g:repo, 'reuse_test.txt', "content\n")
  call ghostgit#diff#Open('reuse_test.txt')
  let g:first_bufnr = bufnr('%')
  call ghostgit#diff#Open('reuse_test.txt')
  let g:second_bufnr = bufnr('%')
  Assert g:first_bufnr ==# g:second_bufnr

Execute (diff#OpenStaged shows all staged changes):
  execute 'cd ' . fnameescape(g:repo)
  call ghostgit#test#CreateFile(g:repo, 'stage1.txt', "content1\n")
  call ghostgit#test#CreateFile(g:repo, 'stage2.txt', "content2\n")
  call ghostgit#test#StageFile(g:repo, 'stage1.txt')
  call ghostgit#test#StageFile(g:repo, 'stage2.txt')
  call ghostgit#diff#OpenStaged()
  let g:text = join(getline(1, '$'), "\n")
  Assert g:text =~# 'stage1.txt'
  Assert g:text =~# 'stage2.txt'

Execute (diff#CompareCommits compares two commits):
  execute 'cd ' . fnameescape(g:repo)
  call ghostgit#test#CreateFile(g:repo, 'version.txt', "version1\n")
  call ghostgit#test#StageFile(g:repo, 'version.txt')
  call ghostgit#core#Run(['commit', '-m', 'First commit'])
  let g:commit1 = ghostgit#core#Run(['rev-parse', 'HEAD'])[0]
  call ghostgit#test#CreateFile(g:repo, 'version.txt', "version1\nversion2\n")
  call ghostgit#test#StageFile(g:repo, 'version.txt')
  call ghostgit#core#Run(['commit', '-m', 'Second commit'])
  let g:commit2 = ghostgit#core#Run(['rev-parse', 'HEAD'])[0]
  call ghostgit#diff#CompareCommits(g:commit1, g:commit2)
  let g:text = join(getline(1, '$'), "\n")
  Assert g:text =~# 'diff --git'
  Assert g:text =~# 'version2'

Execute (diff#Open handles empty filename):
  execute 'cd ' . fnameescape(g:repo)
  try
    call ghostgit#diff#Open('')
  catch
  endtry

Execute (diff#Open outside repository):
  execute 'cd ' . fnameescape(g:cwd)
  call ghostgit#diff#Open('test.txt')

Execute (diff#Open performs reasonably fast):
  execute 'cd ' . fnameescape(g:repo)
  let g:large_content = []
  for i in range(1000)
    call add(g:large_content, "Line " . i)
  endfor
  call ghostgit#test#CreateFile(g:repo, 'large_file.txt', join(g:large_content, "\n"))
  let g:diff_start = reltime()
  call ghostgit#diff#Open('large_file.txt')
  let g:diff_elapsed = reltimefloat(reltime(g:diff_start))
  Assert g:diff_elapsed < 2.0
