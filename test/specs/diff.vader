Execute (diff#Open handles empty filename):
  " Cambiar al directorio del repositorio
  execute 'cd ' . fnameescape(g:repo)
  
  " Intentar abrir diff con nombre de archivo vacío
  try
    call ghostgit#diff#Open('')
  catch
    " Debería manejar el error apropiadamente
  endtry

Execute (diff#Open outside repository):
  " Cambiar a directorio fuera del repositorio
  execute 'cd ' . fnameescape(g:cwd)
  
  " Intentar abrir diff (debería fallar apropiadamente)
  " Esta prueba depende de cómo se maneje el error en la implementación

" ============================================================================
" Performance Tests
" ============================================================================

Execute (diff#Open performs reasonably fast):
  " Cambiar al directorio del repositorio
  execute 'cd ' . fnameescape(g:repo)
  
  " Crear archivo grande para diff
  let l:large_content = []
  for l:i in range(1000)
    call add(l:large_content, "Line " . l:i)
  endfor
  call ghostgit#test#CreateFile(g:repo, 'large_file.txt', join(l:large_content, "\n"))
  
  " Medir tiempo de apertura de diff
  let l:start = reltime()
  call ghostgit#diff#Open('large_file.txt')
  let l:elapsed = reltimefloat(reltime(l:start))
  
  " Debería abrir razonablemente rápido
  Assert l:elapsed < 2.0