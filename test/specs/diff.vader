  let l:initial_lines = line('$')
  
  " Modificar archivo
  call ghostgit#test#CreateFile(g:repo, 'refresh_test.txt', "line1\nline2\n")
  
  " Refrescar diff (requiere estar en buffer de diff)
  " Esta prueba puede requerir ajustes según la implementación
  
" ============================================================================
" ghostgit#diff#OpenStaged Tests
" ============================================================================

Execute (diff#OpenStaged shows all staged changes):
  " Cambiar al directorio del repositorio
  execute 'cd ' . fnameescape(g:repo)
  
  " Crear varios archivos y agregarlos al staging
  call ghostgit#test#CreateFile(g:repo, 'file1.txt', "content1\n")
  call ghostgit#test#CreateFile(g:repo, 'file2.txt', "content2\n")
  call ghostgit#test#StageFile(g:repo, 'file1.txt')
  call ghostgit#test#StageFile(g:repo, 'file2.txt')
  
  " Abrir diff de todos los archivos en staging
  call ghostgit#diff#OpenStaged()
  
  " Verificar contenido
  let g:text = join(getline(1, '$'), "\n")
  Assert g:text =~# 'file1.txt'
  Assert g:text =~# 'file2.txt'

" ============================================================================
" ghostgit#diff#CompareCommits Tests
" ============================================================================

Execute (diff#CompareCommits compares two commits):
  " Cambiar al directorio del repositorio
  execute 'cd ' . fnameescape(g:repo)
  
  " Crear commit inicial
  call ghostgit#test#CreateFile(g:repo, 'version1.txt', "version1\n")
  call ghostgit#test#StageFile(g:repo, 'version1.txt')
  call ghostgit#core#Run(['commit', '-m', 'Initial commit'])
  
  " Guardar hash del primer commit
  let l:commit1 = ghostgit#core#Run(['rev-parse', 'HEAD'])[0]
  
  " Modificar archivo y crear segundo commit
  call ghostgit#test#CreateFile(g:repo, 'version1.txt', "version1\nversion2\n")
  call ghostgit#test#StageFile(g:repo, 'version1.txt')
  call ghostgit#core#Run(['commit', '-m', 'Second commit'])
  
  " Guardar hash del segundo commit
  let l:commit2 = ghostgit#core#Run(['rev-parse', 'HEAD'])[0]
  
  " Comparar los dos commits
  call ghostgit#diff#CompareCommits(l:commit1, l:commit2)
  
  " Verificar contenido del diff
  let g:text = join(getline(1, '$'), "\n")
  Assert g:text =~# 'diff --git'
  Assert g:text =~# 'version2'

