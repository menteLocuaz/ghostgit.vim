Before:
  let g:ghostgit_async_disable = 1
  call ghostgit#state#Init()
  let g:repo = ghostgit#test#Setup()
  let g:cwd = getcwd()

After:
  call ghostgit#test#Teardown(g:repo)
  silent! bd!
  execute 'cd ' . fnameescape(g:cwd)

Execute (branch#Open creates branch buffer):
  execute 'cd ' . fnameescape(g:repo)
  call ghostgit#branch#Open()
  Assert bufname('%') =~# 'ghostgit://branch'
  Assert &filetype ==# 'ghostgit_branch'

Execute (branch#Open errors outside repo):
  let g:plain = tempname()
  call mkdir(g:plain, 'p')
  execute 'cd ' . fnameescape(g:plain)
  call ghostgit#branch#Open()
  call delete(g:plain, 'rf')
  Assert 1

Execute (branch#Checkout checks out branch):
  execute 'cd ' . fnameescape(g:repo)
  call ghostgit#core#Run(['checkout', '-b', 'other-branch'], g:repo)
  call ghostgit#branch#Open()
  call cursor(3, 1)
  call ghostgit#branch#Checkout()
  Assert 1
