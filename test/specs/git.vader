Before:
  let g:repo = ghostgit#test#Setup()
  let g:cwd = getcwd()

After:
  call ghostgit#test#Teardown(g:repo)
  execute 'cd ' . fnameescape(g:cwd)

Execute (ghostgit#git#Status returns branch info):
  let g:result = ghostgit#git#Status(g:repo)
  Assert len(g:result) > 0
  Assert g:result[0] =~# '## main'

Execute (ghostgit#git#Add stages a file):
  call ghostgit#test#CreateFile(g:repo, 'test.txt', 'hello')
  call ghostgit#git#Add('test.txt', g:repo)
  let g:result = ghostgit#git#Status(g:repo)
  let g:staged = filter(copy(g:result), {_, v -> v =~# 'A  test\.txt'})
  Assert len(g:staged) > 0

Execute (ghostgit#git#Reset unstages a file):
  call ghostgit#test#CreateFile(g:repo, 'test.txt', 'hello')
  call ghostgit#test#StageFile(g:repo, 'test.txt')
  call ghostgit#git#Reset('test.txt', g:repo)
  let g:result = ghostgit#git#Status(g:repo)
  let g:untracked = filter(copy(g:result), {_, v -> v =~# '??'})
  Assert len(g:untracked) > 0

Execute (ghostgit#git#Diff returns diff for modified file):
  call ghostgit#test#CreateFile(g:repo, 'test.txt', "hello\n")
  call ghostgit#test#StageFile(g:repo, 'test.txt')
  call ghostgit#test#CreateFile(g:repo, 'test.txt', "hello\nworld\n")
  let g:result = ghostgit#git#Diff('test.txt', '', g:repo)
  Assert len(g:result) > 0
  Assert join(g:result, "\n") =~# '^diff --git'
