Before:
  let g:ghostgit_async_disable = 1
  call ghostgit#state#Init()
  let g:repo = ghostgit#test#Setup()
  let g:cwd = getcwd()

After:
  call ghostgit#test#Teardown(g:repo)
  silent! bd!
  execute 'cd ' . fnameescape(g:cwd)

Execute (blame#Open errors outside repo):
  enew
  call ghostgit#blame#Open()
  Assert 1

Execute (blame#Open errors with no file):
  execute 'cd ' . fnameescape(g:repo)
  enew
  call ghostgit#blame#Open()
  Assert 1

Execute (blame#Open creates blame buffer):
  execute 'cd ' . fnameescape(g:repo)
  call ghostgit#test#CreateFile(g:repo, 'blame_test.txt', "line1\nline2\n")
  call ghostgit#test#StageFile(g:repo, 'blame_test.txt')
  call ghostgit#core#Run(['commit', '-m', 'add blame_test'], g:repo)
  execute 'edit ' . g:repo . '/blame_test.txt'
  call ghostgit#blame#Open()
  Assert bufname('%') =~# 'ghostgit://blame/'
